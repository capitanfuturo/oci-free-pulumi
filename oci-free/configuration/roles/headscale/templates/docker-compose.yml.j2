services:
  headscale:
    image: "{{ headscale_image }}:{{ headscale_version }}"
    container_name: headscale
    labels:
      me.tale.headplane.target: headscale
    restart: unless-stopped
    command: serve
    volumes:
      - "{{ headscale_data_dir }}/config:/etc/headscale:ro"
      - "{{ headscale_data_dir }}/lib:/var/lib/headscale"
    ports:
      - "127.0.0.1:9090:9090"

  headplane:
    image: "{{ headplane_image }}:{{ headplane_version }}"
    container_name: headplane
    restart: unless-stopped
    depends_on:
      - headscale
    volumes:
      - "{{ headscale_data_dir }}/headplane/config.yaml:/etc/headplane/config.yaml:ro"
      - "{{ headscale_data_dir }}/headplane/data:/var/lib/headplane"
      - "{{ headscale_data_dir }}/config/config.yaml:/etc/headscale/config.yaml:ro"
      - "/var/run/docker.sock:/var/run/docker.sock:ro"

  caddy:
    image: caddy:2
    container_name: headscale-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - "{{ headscale_data_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
      - "{{ headscale_data_dir }}/caddy_data:/data"
      - "{{ headscale_data_dir }}/caddy_config:/config"
